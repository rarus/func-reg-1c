    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Функции.Ссылка КАК Ссылка,
	Функции.ПометкаУдаления КАК ПометкаУдаления,
	Функции.Родитель КАК Родитель,
	Функции.Код КАК Код,
	Функции.Наименование КАК Наименование,
	ВЫРАЗИТЬ(Функции.Содержание КАК СТРОКА(1024)) КАК Содержание,
	Функции.Проект КАК Проект,
	Функции.Предопределенный КАК Предопределенный,
	Функции.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА НЕ Функции.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
			ТОГДА Функции.Родитель
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
	КОНЕЦ КАК Уровень2Группа,
	ВЫБОР
		КОГДА Функции.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
			ТОГДА Функции.Родитель
		ИНАЧЕ ЕСТЬNULL(Функции.Родитель.Родитель, ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка))
	КОНЕЦ КАК Уровень1Группа,
	Функции.Автор КАК Автор,
	Функции.ДатаИзменения КАК ДатаИзменения,
	Функции.ДатаСоздания КАК ДатаСоздания,
	Функции.Комментарий КАК Комментарий,
	МАКСИМУМ(НЕ ВнутренниеОбсуждения.Прочитано) КАК НовоеУведомление
ИЗ
	Справочник.Функции КАК Функции
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВнутренниеОбсуждения КАК ВнутренниеОбсуждения
		ПО (Функции.Ссылка = (ВЫРАЗИТЬ(ВнутренниеОбсуждения.Объект КАК Справочник.Функции)))
			И (НЕ ВнутренниеОбсуждения.Пользователь = &amp;Пользователь)
			И (ВнутренниеОбсуждения.ПользовательАдресат = &amp;Пользователь
				ИЛИ ВнутренниеОбсуждения.ПользовательАдресат = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))

СГРУППИРОВАТЬ ПО
	Функции.Ссылка,
	Функции.ПометкаУдаления,
	Функции.Родитель,
	Функции.Код,
	Функции.Наименование,
	Функции.Проект,
	Функции.Предопределенный,
	Функции.ИмяПредопределенныхДанных,
	Функции.Автор,
	Функции.ДатаИзменения,
	Функции.ДатаСоздания,
	Функции.Комментарий,
	ВЫРАЗИТЬ(Функции.Содержание КАК СТРОКА(1024)),
	ВЫБОР
		КОГДА НЕ Функции.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
			ТОГДА Функции.Родитель
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА Функции.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
			ТОГДА Функции.Родитель
		ИНАЧЕ ЕСТЬNULL(Функции.Родитель.Родитель, ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка))
	КОНЕЦ</queryText>
