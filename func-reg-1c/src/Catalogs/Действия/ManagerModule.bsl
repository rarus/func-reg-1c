Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	
	ДоступИзмененОбъект = ДоступИзменен.ПолучитьОбъект();
	ДоступИзмененОбъект.Символ = Лев(ДоступИзмененОбъект.Наименование, 1);
	ДоступИзмененОбъект.Записать();
	
	ИзмененОбъект = Изменен.ПолучитьОбъект();
	ИзмененОбъект.Символ = Лев(ИзмененОбъект.Наименование, 1);
	ИзмененОбъект.Записать();
	
	СозданОбъект = Создан.ПолучитьОбъект();
	СозданОбъект.Символ = Лев(СозданОбъект.Наименование, 1);
	СозданОбъект.Записать();
	
	УдаленОбъект = Удален.ПолучитьОбъект();
	УдаленОбъект.Символ = Лев(УдаленОбъект.Наименование, 1);
	УдаленОбъект.Записать();
	
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()

