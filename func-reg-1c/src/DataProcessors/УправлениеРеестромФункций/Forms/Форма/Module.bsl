#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СвернутьДерево(Команда)

	ТекущийЭлементИмя = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();
	
	ТекущееДеревоЗначений = ЭтотОбъект[ТекущийЭлементИмя]; // ДанныеФормыДерево
	ЭлементыКорняДерева = ТекущееДеревоЗначений.ПолучитьЭлементы();
	Для Каждого ЭлементКорняДерева Из ЭлементыКорняДерева Цикл
		Элементы[ТекущийЭлементИмя].Свернуть(ЭлементКорняДерева.ПолучитьИдентификатор());
		Элементы[ТекущийЭлементИмя + "1"].Свернуть(ЭлементКорняДерева.ПолучитьИдентификатор());
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево(Команда)

	РазвернутьДеревоНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)

	ТекущийЭлементИмя = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();
	
	ТекущееДеревоЗначений = ЭтотОбъект[ТекущийЭлементИмя]; // ДанныеФормыДерево
	ЭлементыКорняДерева = ТекущееДеревоЗначений.ПолучитьЭлементы();
	УстановитьСнятьФлажкиРекурсивно(ЭлементыКорняДерева);

КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	ТекущийЭлементИмя = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();
	
	ТекущееДеревоЗначений = ЭтотОбъект[ТекущийЭлементИмя]; // ДанныеФормыДерево
	ЭлементыКорняДерева = ТекущееДеревоЗначений.ПолучитьЭлементы();
	УстановитьСнятьФлажкиРекурсивно(ЭлементыКорняДерева, 0);

КонецПроцедуры

&НаКлиенте
Процедура СкрытьНастройки(Команда)

	Элементы.ГруппаНастройки.Видимость = Не Элементы.ГруппаНастройки.Видимость;
	
	Если Элементы.ГруппаНастройки.Видимость Тогда
		Элементы.ОбновитьТабличныйДокументИСписокРегистраСведенийМини.Видимость = Ложь;
		Элементы.СкрытьНастройки.Картинка = БиблиотекаКартинок.СтрелкаВлево;
	Иначе
		Элементы.ОбновитьТабличныйДокументИСписокРегистраСведенийМини.Видимость = Истина;
		Элементы.СкрытьНастройки.Картинка = БиблиотекаКартинок.СтрелкаВправо;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСпискиОтборов(Команда)

	ЗаполнитьТаблицыОтборов();

	РазвернутьДеревоНаКлиенте("ОтборОбъект");
	РазвернутьДеревоНаКлиенте("ОтборФункция");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТабличныйДокументИСписокРегистраСведений(Команда)

	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;

	СтруктураОтборов = ПолучитьОтборыИзПанелиНастроек();

	Если Элементы.СтраницыРеестрФункций.ТекущаяСтраница = Элементы.СтраницаОтчет Тогда
		ОбновитьТабличныйДокументНаСервере(СтруктураОтборов);
	Иначе
		ОбновитьСписокРегистраСведенийНаСервере(СтруктураОтборов);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодборДляВключения(Команда)
	
	ИмяТекущегоЭлемента = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();
	ИмяТекущегоСравочника = ПолучитьИмяТекущегоСправочника(ИмяТекущегоЭлемента);
	Если ПустаяСтрока(ИмяТекущегоСравочника) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения", ЭтотОбъект, "Включить");
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("МножественныйВыбор", Истина);
	
	ОткрытьФорму(
		"Справочник." + ИмяТекущегоСравочника + ".ФормаВыбора",
		ПараметрыОткрытия,
		ЭтотОбъект, , , ,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборДляИсключения(Команда)
	
	ИмяТекущегоЭлемента = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();
	ИмяТекущегоСравочника = ПолучитьИмяТекущегоСправочника(ИмяТекущегоЭлемента);
	Если ПустаяСтрока(ИмяТекущегоСравочника) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения", ЭтотОбъект, "Выключить");
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("МножественныйВыбор", Истина);
	
	ОткрытьФорму(
		"Справочник." + ИмяТекущегоСравочника + ".ФормаВыбора",
		ПараметрыОткрытия,
		ЭтотОбъект, , , ,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Обработчик события нажатия кнопки "ОткрытьОПрограмме".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ОткрытьОПрограмме(Команда)
	
	ОткрытьФорму("Обработка.УправлениеРеестромФункций.Форма.ОПродукте", , , , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтчет(Команда)
	
	РежимОтображения = 0;
	РежимОтображенияПриИзменении();
	Элементы.РежимОтчет.Пометка = Истина;
	Элементы.РежимРегистр.Пометка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимРегистр(Команда)
	
	РежимОтображения = 1;
	РежимОтображенияПриИзменении();
	Элементы.РежимОтчет.Пометка = Ложь;
	Элементы.РежимРегистр.Пометка = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицыОтборов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектыФункцийГруппы.Ссылка КАК Группа,
	|	ОбъектыФункций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбъектыФункций КАК ОбъектыФункцийГруппы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыФункций КАК ОбъектыФункций
	|		ПО (ОбъектыФункцийГруппы.Ссылка = ОбъектыФункций.Родитель
	|		И НЕ ОбъектыФункций.ПометкаУдаления
	|		И НЕ ОбъектыФункций.ЭтоГруппа)
	|ГДЕ
	|	НЕ ОбъектыФункцийГруппы.ПометкаУдаления
	|	И ОбъектыФункцийГруппы.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектыФункцийГруппы.Код,
	|	ОбъектыФункций.Наименование
	|ИТОГИ
	|ПО
	|	Группа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗадачиУчетныхСистем.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗадачиУчетныхСистем КАК ЗадачиУчетныхСистем
	|ГДЕ
	|	НЕ ЗадачиУчетныхСистем.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗадачиУчетныхСистем.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ФункцииПервыйУровень.Ссылка КАК ГруппаПервыйУровень,
	|	ФункцииВторойУровень.Ссылка КАК ГруппаВторойУровень,
	|	Функции.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Функции КАК ФункцииПервыйУровень
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Функции КАК ФункцииВторойУровень
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Функции КАК Функции
	|			ПО ФункцииВторойУровень.Ссылка = Функции.Родитель
	|			И НЕ Функции.ПометкаУдаления
	|		ПО ФункцииПервыйУровень.Ссылка = ФункцииВторойУровень.Родитель
	|		И НЕ ФункцииВторойУровень.ПометкаУдаления
	|ГДЕ
	|	НЕ ФункцииПервыйУровень.ПометкаУдаления
	|	И ФункцииПервыйУровень.Родитель = ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФункцииПервыйУровень.Код,
	|	ФункцииВторойУровень.Код,
	|	Функции.Наименование
	|ИТОГИ
	|ПО
	|	ГруппаПервыйУровень,
	|	ГруппаВторойУровень
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Действия.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Действия КАК Действия
	|ГДЕ
	|	НЕ Действия.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|
	|	Действия.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Статусы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Статусы КАК Статусы
	|ГДЕ
	|	НЕ Статусы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|
	|	Статусы.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	НЕ Пользователи.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователи.Наименование";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// Отбор объект
	ВыборкаОтборОбъект = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЭлементыКорняДерева = ОтборОбъект.ПолучитьЭлементы();
	ЭлементыКорняДерева.Очистить();
	Пока ВыборкаОтборОбъект.Следующий() Цикл
		// группировка
		ЭлементКорняДерева = ЭлементыКорняДерева.Добавить();
		ЭлементКорняДерева.Использование = 1;
		ЭлементКорняДерева.ОтборЭлемент  = ВыборкаОтборОбъект.Группа;
		// элементы
		Выборка = ВыборкаОтборОбъект.Выбрать();
		ЭлементыПервогоУровня = ЭлементКорняДерева.ПолучитьЭлементы();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			ЭлементПервогоУровняДерева = ЭлементыПервогоУровня.Добавить();
			ЭлементПервогоУровняДерева.Использование = 1;
			ЭлементПервогоУровняДерева.ОтборЭлемент  = Выборка.Ссылка;
		КонецЦикла;
	КонецЦикла;
	
	// Отбор задача
	ВыборкаОтборЗадача = РезультатЗапроса[1].Выбрать();
	ЭлементыКорняДерева = ОтборЗадача.ПолучитьЭлементы();
	ЭлементыКорняДерева.Очистить();
	Пока ВыборкаОтборЗадача.Следующий() Цикл
		// элементы
		ЭлементКорняДерева = ЭлементыКорняДерева.Добавить();
		ЭлементКорняДерева.Использование = 1;
		ЭлементКорняДерева.ОтборЭлемент  = ВыборкаОтборЗадача.Ссылка;
	КонецЦикла;
	
	// Отбор функция
	ВыборкаОтборФункция = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЭлементыКорняДерева = ОтборФункция.ПолучитьЭлементы();
	ЭлементыКорняДерева.Очистить();
	Пока ВыборкаОтборФункция.Следующий() Цикл
		// группировка 1 уровень
		ЭлементКорняДерева = ЭлементыКорняДерева.Добавить();
		ЭлементКорняДерева.Использование = 1;
		ЭлементКорняДерева.ОтборЭлемент  = ВыборкаОтборФункция.ГруппаПервыйУровень;
		// элементы 1 уровень
		ВыборкаПервыйУровень = ВыборкаОтборФункция.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ЭлементыПервогоУровня = ЭлементКорняДерева.ПолучитьЭлементы();
		Пока ВыборкаПервыйУровень.Следующий() Цикл
			Если Не ЗначениеЗаполнено(ВыборкаПервыйУровень.ГруппаВторойУровень) Тогда
				Продолжить;
			КонецЕсли;
			// группировка 2 уровень
			ЭлементПервогоУровняДерева = ЭлементыПервогоУровня.Добавить();
			ЭлементПервогоУровняДерева.Использование = 1;
			ЭлементПервогоУровняДерева.ОтборЭлемент  = ВыборкаПервыйУровень.ГруппаВторойУровень;
			// элементы 2 уровень
			Выборка = ВыборкаПервыйУровень.Выбрать();
			ЭлементыВторогоУровня = ЭлементПервогоУровняДерева.ПолучитьЭлементы();
			Пока Выборка.Следующий() Цикл
				Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
					Продолжить;
				КонецЕсли;
				ЭлементВторогоУровняДерева = ЭлементыВторогоУровня.Добавить();
				ЭлементВторогоУровняДерева.Использование = 1;
				ЭлементВторогоУровняДерева.ОтборЭлемент  = Выборка.Ссылка;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// Отбор действие
	ВыборкаОтборДействие = РезультатЗапроса[3].Выбрать();
	ЭлементыКорняДерева = ОтборДействие.ПолучитьЭлементы();
	ЭлементыКорняДерева.Очистить();
	Пока ВыборкаОтборДействие.Следующий() Цикл
		// элементы
		ЭлементКорняДерева = ЭлементыКорняДерева.Добавить();
		ЭлементКорняДерева.Использование = 1;
		ЭлементКорняДерева.ОтборЭлемент  = ВыборкаОтборДействие.Ссылка;
	КонецЦикла;
	
	// Отбор статус
	ВыборкаОтборСтатус = РезультатЗапроса[4].Выбрать();
	ЭлементыКорняДерева = ОтборСтатус.ПолучитьЭлементы();
	ЭлементыКорняДерева.Очистить();
	Пока ВыборкаОтборСтатус.Следующий() Цикл
		// элементы
		ЭлементКорняДерева = ЭлементыКорняДерева.Добавить();
		ЭлементКорняДерева.Использование = 1;
		ЭлементКорняДерева.ОтборЭлемент  = ВыборкаОтборСтатус.Ссылка;
	КонецЦикла;
	
	// Отбор автор
	ВыборкаОтборАвтор = РезультатЗапроса[5].Выбрать();
	ЭлементыКорняДерева = ОтборАвтор.ПолучитьЭлементы();
	ЭлементыКорняДерева.Очистить();
	Пока ВыборкаОтборАвтор.Следующий() Цикл
		// элементы
		ЭлементКорняДерева = ЭлементыКорняДерева.Добавить();
		ЭлементКорняДерева.Использование = 1;
		ЭлементКорняДерева.ОтборЭлемент  = ВыборкаОтборАвтор.Ссылка;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВключитьВыключитьОтборы(ИмяНастройкиОтбора)

	ИмяОтбора = СтрЗаменить(ИмяНастройкиОтбора, "Использовать", "");

	ВидимостьОтбора = ЭтотОбъект[ИмяНастройкиОтбора]; // Булево
	Элементы[ИмяОтбора].Видимость = ВидимостьОтбора;
	Элементы[ИмяОтбора + "1"].Видимость = ВидимостьОтбора;
	Элементы[ИмяОтбора + "Группа"].Видимость = ВидимостьОтбора;

	Элементы.ОбновитьСпискиОтборов.Видимость = ИспользоватьОтборАвтор Или ИспользоватьОтборДействие Или ИспользоватьОтборЗадача
		Или ИспользоватьОтборОбъект Или ИспользоватьОтборСтатус Или ИспользоватьОтборФункция;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСоответствиеДоступныхОтборов()

	СоответствиеДоступныхОтборов = Новый Соответствие;

	СоответствиеДоступныхОтборов.Вставить("ОтборАвтор", ОтборАвтор);
	СоответствиеДоступныхОтборов.Вставить("ОтборДействие", ОтборДействие);
	СоответствиеДоступныхОтборов.Вставить("ОтборЗадача", ОтборЗадача);
	СоответствиеДоступныхОтборов.Вставить("ОтборОбъект", ОтборОбъект);
	СоответствиеДоступныхОтборов.Вставить("ОтборСтатус", ОтборСтатус);
	СоответствиеДоступныхОтборов.Вставить("ОтборФункция", ОтборФункция);

	Возврат СоответствиеДоступныхОтборов;

КонецФункции

&НаКлиенте
Процедура УстановитьСнятьФлажкиРекурсивно(
	ЭлементыУровняДерева,
	ЗначениеФлажка = 1,
	МассивДляУстановки = Неопределено,
	МассивДляСнятия = Неопределено)
	
	Для Каждого ЭлементУровняДерева Из ЭлементыУровняДерева Цикл
		
		Если ЗначениеФлажка = 1 И НЕ МассивДляУстановки = Неопределено Тогда
			Если НЕ МассивДляУстановки.Найти(ЭлементУровняДерева.ОтборЭлемент) = Неопределено Тогда
				ЭлементУровняДерева.Использование = 1;
			КонецЕсли;
		ИначеЕсли ЗначениеФлажка = 0 И НЕ МассивДляСнятия = Неопределено Тогда
			Если НЕ МассивДляСнятия.Найти(ЭлементУровняДерева.ОтборЭлемент) = Неопределено Тогда
				ЭлементУровняДерева.Использование = 0;
			КонецЕсли;
		Иначе
			ЭлементУровняДерева.Использование = ЗначениеФлажка;
		КонецЕсли;
		
		УстановитьСнятьФлажкиРекурсивно(
			ЭлементУровняДерева.ПолучитьЭлементы(),
			ЗначениеФлажка,
			МассивДляУстановки,
			МассивДляСнятия);
		
	КонецЦикла;
	
	Если ЭлементыУровняДерева.Количество() Тогда
		
		Родитель = ЭлементУровняДерева.ПолучитьРодителя();
		Пока Не Родитель = Неопределено Цикл
			Родитель.Использование = УстановитьЗначениеФлажкаРодителя(Родитель);
			Родитель = Родитель.ПолучитьРодителя();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеИзменение()
	
	ТекущийЭлементИмя = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();
	
	ТекущиеДанные = Элементы[ТекущийЭлементИмя].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЭлементИмяБезЗамены = ПолучитьИмяТекущегоЭлементаФормы();
	Если НЕ ТекущийЭлементИмяБезЗамены = ТекущийЭлементИмя Тогда
		ТекущиеДанныеБезЗамены = Элементы[ТекущийЭлементИмяБезЗамены].ТекущиеДанные;
		Если ТекущиеДанныеБезЗамены = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если ТекущиеДанныеБезЗамены.Использование = 2 Тогда
			ТекущиеДанныеБезЗамены.Использование = 0;
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущиеДанные.Использование = 2 Тогда
		ТекущиеДанные.Использование = 0;
	КонецЕсли;

	Идентификатор = ТекущиеДанные.ПолучитьИдентификатор();
	ТекущееДеревоЗначений = ЭтотОбъект[ТекущийЭлементИмя]; // ДанныеФормыДерево
	ЭлементыДерева = ТекущееДеревоЗначений.НайтиПоИдентификатору(Идентификатор).ПолучитьЭлементы();
	Если ТекущиеДанные.Использование = 1 Тогда
		УстановитьСнятьФлажкиРекурсивно(ЭлементыДерева);
	Иначе
		УстановитьСнятьФлажкиРекурсивно(ЭлементыДерева, 0);
	КонецЕсли;

	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Пока Не Родитель = Неопределено Цикл
		Родитель.Использование = УстановитьЗначениеФлажкаРодителя(Родитель);
		Родитель = Родитель.ПолучитьРодителя();
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеИзменениеБезЗаменыИмени()
	
	ТекущийЭлементИмя = ПолучитьИмяТекущегоЭлементаФормы();
	ТекущийЭлементИмяСЗаменой = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();
	
	ТекущиеДанные = Элементы[ТекущийЭлементИмя].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Использование = 2 Тогда
		ТекущиеДанные.Использование = 0;
	КонецЕсли;

	Идентификатор = ТекущиеДанные.ПолучитьИдентификатор();
	ТекущееДеревоЗначений = ЭтотОбъект[ТекущийЭлементИмяСЗаменой]; // ДанныеФормыДерево
	ЭлементыДерева = ТекущееДеревоЗначений.НайтиПоИдентификатору(Идентификатор).ПолучитьЭлементы();
	Если ТекущиеДанные.Использование = 1 Тогда
		УстановитьСнятьФлажкиРекурсивно(ЭлементыДерева);
	Иначе
		УстановитьСнятьФлажкиРекурсивно(ЭлементыДерева, 0);
	КонецЕсли;

	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Пока Не Родитель = Неопределено Цикл
		Родитель.Использование = УстановитьЗначениеФлажкаРодителя(Родитель);
		Родитель = Родитель.ПолучитьРодителя();
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция УстановитьЗначениеФлажкаРодителя(Родитель)

	ВПодчиненныхЕстьИстина = НайтиЗначениеФлажкаРодителяРекурсивно(Родитель.ПолучитьЭлементы(), 1);
	ВПодчиненныхЕстьЛожь   = НайтиЗначениеФлажкаРодителяРекурсивно(Родитель.ПолучитьЭлементы());

	Если ВПодчиненныхЕстьИстина И ВПодчиненныхЕстьЛожь Тогда
		Результат = 2;
	ИначеЕсли ВПодчиненныхЕстьИстина Тогда
		Результат = 1;
	Иначе
		Результат = 0;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция НайтиЗначениеФлажкаРодителяРекурсивно(ЭлементыДерева, Значение = 0)

	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Если ЭлементДерева.Использование = Значение Или НайтиЗначениеФлажкаРодителяРекурсивно(
			ЭлементДерева.ПолучитьЭлементы(), Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура РазвернутьДеревоНаКлиенте(ТекущееДеревоЗначенийИмя = "")
	
	Если ПустаяСтрока(ТекущееДеревоЗначенийИмя) Тогда
		ТекущееДеревоЗначенийИмяДляРазвертки = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();
	Иначе
		ТекущееДеревоЗначенийИмяДляРазвертки = ТекущееДеревоЗначенийИмя;
	КонецЕсли;
	
	ТекущееДеревоЗначений = ЭтотОбъект[ТекущееДеревоЗначенийИмяДляРазвертки]; // ДанныеФормыДерево
	ЭлементыКорняДерева = ТекущееДеревоЗначений.ПолучитьЭлементы();
	Для Каждого ЭлементКорняДерева Из ЭлементыКорняДерева Цикл
		Элементы[ТекущееДеревоЗначенийИмяДляРазвертки].Развернуть(ЭлементКорняДерева.ПолучитьИдентификатор(), Истина);
		Элементы[ТекущееДеревоЗначенийИмяДляРазвертки + "1"].Развернуть(ЭлементКорняДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТабличныйДокументНаСервере(СтруктураОтборов)
	
	//Получаем схему из макета
	СхемаКомпоновкиДанных = Отчеты.АнализРеестраФункций.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	//Из схемы возьмем настройки по умолчанию
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	//Устанавливаем отборы
	УстановитьОтборыТабличногоДокумента(СтруктураОтборов, Настройки);
	
	//Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровкиСКД = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровкиСКД);
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровкиСКД);
	
	//Очищаем поле табличного документа
	ТабличноеПолеОтчета.Очистить();
	
	//Выводим результат в табличный документ
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличноеПолеОтчета);

	Попытка

		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		ДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиСКД, УникальныйИдентификатор);

		ОтображениеСостояния = Элементы.ТабличноеПолеОтчета.ОтображениеСостояния;
		ОтображениеСостояния.Видимость                      = Ложь;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
		ОтображениеСостояния.Картинка                       = Новый Картинка;
		ОтображениеСостояния.Текст                          = "";

	Исключение

		ОтображениеСостояния = Элементы.ТабличноеПолеОтчета.ОтображениеСостояния;
		ОтображениеСостояния.Видимость                      = Истина;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
		ОтображениеСостояния.Картинка                       = Новый Картинка;
		ОтображениеСостояния.Текст                          = ОписаниеОшибки();

	КонецПопытки;
	
	ОбновитьСписокОшибок();
	
	РеестрФункцийСервер.РегистрацияСобытия("УправлениеРеестромФункций.ОбновитьТабличныйДокумент");
	
