&НаКлиенте
Процедура ТабличноеПолеОтчетаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)

	СтандартнаяОбработка = Ложь;

	ЗначениеПоля = ПолучитьЗначениеПоляРасшифровки(Расшифровка);

	Если ТипЗнч(ЗначениеПоля) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(ЗначениеПоля.Символ) Тогда
			ПараметрыОткрытия = Новый Структура("Ключ", ЗначениеПоля.Ключ);
		Иначе
			ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", ЗначениеПоля.СтруктураПоля);
		КонецЕсли;
		ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения", ЭтотОбъект);
		ОткрытьФорму(
			"РегистрСведений.РеестрФункций.ФормаЗаписи",
			ПараметрыОткрытия,
			ЭтотОбъект,
			УникальныйИдентификатор, , ,
			ОписаниеОповещения,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли ЗначениеЗаполнено(ЗначениеПоля) Тогда
		ПоказатьЗначение( , ЗначениеПоля);
	КонецЕсли;

КонецПроцедуры

