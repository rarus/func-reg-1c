
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьТаблицыОтборов();

	ОтображениеСостояния = Элементы.ТабличноеПолеОтчета.ОтображениеСостояния;
	ОтображениеСостояния.Видимость                      = Истина;
	ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
	ОтображениеСостояния.Картинка                       = БиблиотекаКартинок.ДиалогВосклицание;
	ОтображениеСостояния.Текст                          =
		"Для формирования отчета нажмите кнопку обновления в контекстном меню табличного документа или в панели настроек";
	
	ОбновитьСписокОшибок();
	
	ОтборПроект = Константы.ПроектПоУмолчанию.Получить();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	Если Настройки = Неопределено Тогда
		Элементы.СтраницыРеестрФункций.ТекущаяСтраница = Элементы.СтраницаОтчет;
		Элементы.РежимОтчет.Пометка = Истина;
		Возврат;
	КонецЕсли;

	СоответствиеДоступныхОтборов = ПолучитьСоответствиеДоступныхОтборов();

	Для Каждого ДоступныйОтбор Из СоответствиеДоступныхОтборов Цикл
		ИспользованиеОтбора = Настройки.Получить("Использовать" + ДоступныйОтбор.Ключ); // Булево
		Если Не ИспользованиеОтбора = Неопределено Тогда
			Элементы[ДоступныйОтбор.Ключ].Видимость = ИспользованиеОтбора;
			Элементы[ДоступныйОтбор.Ключ + "1"].Видимость = ИспользованиеОтбора;
			Элементы[ДоступныйОтбор.Ключ + "Группа"].Видимость = ИспользованиеОтбора;
		КонецЕсли;
	КонецЦикла;

	Элементы.ОбновитьСпискиОтборов.Видимость = ИспользоватьОтборАвтор Или ИспользоватьОтборДействие Или ИспользоватьОтборЗадача
		Или ИспользоватьОтборОбъект Или ИспользоватьОтборСтатус Или ИспользоватьОтборФункция;

	СтруктураОтборов = ПолучитьОтборыИзПанелиНастроекНаСервере();
	ОбновитьСписокРегистраСведенийНаСервере(СтруктураОтборов);

	Если РежимОтображения = 0 Тогда
		Элементы.СтраницыРеестрФункций.ТекущаяСтраница = Элементы.СтраницаОтчет;
		Элементы.РежимОтчет.Пометка = Истина;
	Иначе
		Элементы.СтраницыРеестрФункций.ТекущаяСтраница = Элементы.СтраницаРегистрСведений;
		Элементы.РежимРегистр.Пометка = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

