	Для Каждого ГруппаЭлементаДереваУровень1 Из ГруппыЭлементовДереваУровень1 Цикл
		ГруппыЭлементовДереваУровень2 = ГруппаЭлементаДереваУровень1.ПолучитьЭлементы();
		Для Каждого ГруппаЭлементаДерева Из ГруппыЭлементовДереваУровень2 Цикл
			ЭлементыДерева = ГруппаЭлементаДерева.ПолучитьЭлементы();
			Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
				Если ЭлементДерева.Использование Тогда
					МассивФункции_Включены.Добавить(ЭлементДерева.ОтборЭлемент);
				Иначе
					МассивФункции_Выключены.Добавить(ЭлементДерева.ОтборЭлемент);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Если МассивФункции_Включены.Количество() < МассивФункции_Выключены.Количество() Тогда
		СтруктураОтборов.Вставить("МассивФункции_Включены", МассивФункции_Включены);
	ИначеЕсли МассивФункции_Выключены.Количество() Тогда
		СтруктураОтборов.Вставить("МассивФункции_Выключены", МассивФункции_Выключены);
	КонецЕсли;

	Возврат СтруктураОтборов;

КонецФункции

// Получить значение поля расшифровки.
// 
// Параметры:
//  Расшифровка - Произвольный - Расшифровка
// 
// Возвращаемое значение:
//  Неопределено, СправочникСсылка, Структура - Получить значение поля расшифровки:
// * Символ - Произвольный 
// * СтруктураПоля - Структура - :
// ** ЗадачаРеестра - СправочникСсылка.ЗадачиУчетныхСистем 
// ** ФункцияРеестра - СправочникСсылка.Функции 
// ** ОбъектРеестра - СправочникСсылка.ОбъектыФункций 
// * Ключ - РегистрСведенийКлючЗаписи.РеестрФункций - 
&НаСервере
Функция ПолучитьЗначениеПоляРасшифровки(Расшифровка)

	ЗначениеПоля = Null; // Произвольный

	ДанныеРасшифровкиСКД = ПолучитьИзВременногоХранилища(ДанныеРасшифровки); // ДанныеРасшифровкиКомпоновкиДанных
	Поля = ДанныеРасшифровкиСКД.Элементы[Расшифровка].ПолучитьПоля();
	Если Поля.Количество() = 1 Тогда
		ЗначениеПоля = Поля[0].Значение;
	ИначеЕсли Поля.Количество() = 5 И Поля[3].Значение = Ложь Тогда
		СтруктураПоля = Новый Структура;
		СтруктураПоля.Вставить("ЗадачаРеестра",  Поля[0].Значение);
		СтруктураПоля.Вставить("ФункцияРеестра", Поля[1].Значение);
		СтруктураПоля.Вставить("ОбъектРеестра",  Поля[2].Значение);
		ЗначениеПоля = Новый Структура;
		ЗначениеПоля.Вставить("Символ", Поля[4].Значение);
		ЗначениеПоля.Вставить("СтруктураПоля", СтруктураПоля);
		ЗначениеПоля.Вставить("Ключ", РегистрыСведений.РеестрФункций.СоздатьКлючЗаписи(СтруктураПоля));
	КонецЕсли;

	Если ЗначениеПоля = Null Или Не Поля.Количество() Тогда
		ЗначениеПоля = Неопределено;
	КонецЕсли;

	Возврат ЗначениеПоля;

КонецФункции

// Подключаемый обработка результата оповещения.
// 
// Параметры:
//  РезультатОповещения - Неопределено
//  ДополнительныеПараметры - Неопределено - Дополнительные параметры
&НаКлиенте
Процедура Подключаемый_ОбработкаРезультатаОповещения(РезультатОповещения, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ДополнительныеПараметры = "Включить" Тогда
		
		Если НЕ РезультатОповещения = Неопределено Тогда
			
			ТекущийЭлементИмя = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();

			ТекущееДеревоЗначений = ЭтотОбъект[ТекущийЭлементИмя]; // ДанныеФормыДерево
			ЭлементыКорняДерева = ТекущееДеревоЗначений.ПолучитьЭлементы();
			УстановитьСнятьФлажкиРекурсивно(ЭлементыКорняДерева, 1, РезультатОповещения);
			
		КонецЕсли;
		
		Возврат;
			
	КонецЕсли;
	
	Если ДополнительныеПараметры = "Выключить" Тогда
		
		Если НЕ РезультатОповещения = Неопределено Тогда
			
			ТекущийЭлементИмя = ПолучитьИмяТекущегоЭлементаФормыСЗаменой();

			ТекущееДеревоЗначений = ЭтотОбъект[ТекущийЭлементИмя]; // ДанныеФормыДерево
			ЭлементыКорняДерева = ТекущееДеревоЗначений.ПолучитьЭлементы();
			УстановитьСнятьФлажкиРекурсивно(ЭлементыКорняДерева, 0, , РезультатОповещения);
			
		КонецЕсли;
		
		Возврат;
			
	КонецЕсли;
	
	Если ОбновлятьТабличныйДокументПриРедактировании Тогда
		СтруктураОтборов = ПолучитьОтборыИзПанелиНастроек();
		ОбновитьТабличныйДокументНаСервере(СтруктураОтборов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяТекущегоЭлементаФормыСЗаменой()
	
	Если Прав(ТекущийЭлемент.Имя, 1) = "1" Тогда
		ТекущийЭлементИмя = Лев(ТекущийЭлемент.Имя, СтрДлина(ТекущийЭлемент.Имя) - 1);
	ИначеЕсли Прав(ТекущийЭлемент.Имя, 12) = "СтрокаПоиска" Тогда
		ТекущийЭлементИмя = Лев(ТекущийЭлемент.Имя, СтрДлина(ТекущийЭлемент.Имя) - 13);
	Иначе
		ТекущийЭлементИмя = ТекущийЭлемент.Имя;
	КонецЕсли;
	
	Возврат ТекущийЭлементИмя;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяТекущегоЭлементаФормы()
	
	ТекущийЭлементИмя = ТекущийЭлемент.Имя;
	
	Возврат ТекущийЭлементИмя;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяТекущегоСправочника(ИмяТекущегоЭлемента)
	
	Если СтрНайти(ИмяТекущегоЭлемента, "ОтборАвтор") Тогда
		ИмяТекущегоСправочника = "Пользователи";
	ИначеЕсли СтрНайти(ИмяТекущегоЭлемента, "ОтборДействие") Тогда
		ИмяТекущегоСправочника = "Действия";
	ИначеЕсли СтрНайти(ИмяТекущегоЭлемента, "ОтборЗадача") Тогда
		ИмяТекущегоСправочника = "ЗадачиУчетныхСистем";
	ИначеЕсли СтрНайти(ИмяТекущегоЭлемента, "ОтборОбъект") Тогда
		ИмяТекущегоСправочника = "ОбъектыФункций";
	ИначеЕсли СтрНайти(ИмяТекущегоЭлемента, "ОтборСтатус") Тогда
		ИмяТекущегоСправочника = "Статусы";
	ИначеЕсли СтрНайти(ИмяТекущегоЭлемента, "ОтборФункция") Тогда
		ИмяТекущегоСправочника = "Функции";
	Иначе
		ИмяТекущегоСправочника = "";
	КонецЕсли;
	
	Возврат ИмяТекущегоСправочника;
		
КонецФункции

&НаКлиенте
Процедура РежимОтображенияПриИзменении()

	Если РежимОтображения = 0 Тогда
		
		Элементы.СтраницыРеестрФункций.ТекущаяСтраница = Элементы.СтраницаОтчет;
		
		ОтображениеСостояния = Элементы.ТабличноеПолеОтчета.ОтображениеСостояния;
		ОтображениеСостояния.Видимость                      = Истина;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
		ОтображениеСостояния.Картинка                       = БиблиотекаКартинок.ДиалогВосклицание;
		ОтображениеСостояния.Текст                          =
			"Для формирования отчета нажмите кнопку обновления в контекстном меню табличного документа или в панели настроек";
		
		Если ОбновлятьТабличныйДокументПриРедактировании Тогда
			СтруктураОтборов = ПолучитьОтборыИзПанелиНастроек();
			ОбновитьТабличныйДокументНаСервере(СтруктураОтборов);
		КонецЕсли;
		
	Иначе
		
		Элементы.СтраницыРеестрФункций.ТекущаяСтраница = Элементы.СтраницаРегистрСведений;
		
	КонецЕсли;

КонецПроцедуры

#Область ЗаполнитьОшибки

&НаСервере
Процедура ОбновитьСписокОшибок()
	
	МассивСообщений = Новый Массив; // Массив из ФорматированнаяСтрока
	
	ЗаполнитьОшибки_НеуникальностьСоздания(МассивСообщений);
	
	Если НЕ МассивСообщений.Количество() Тогда
		СообщениеСтрокаТекст = НСтр("ru = 'Ошибок и рекомендаций не найдено'");
		СообщениеСтрока = Новый ФорматированнаяСтрока(СообщениеСтрокаТекст, Новый Шрифт(, , Истина), ЦветаСтиля.ЦветАктивности);
		МассивСообщений.Добавить(СообщениеСтрока);
	КонецЕсли;
	
	СтрокаСообщений = Новый ФорматированнаяСтрока(МассивСообщений);
	
	ОшибкиДанных = Новый ФорматированныйДокумент;
	ОшибкиДанных.УстановитьФорматированнуюСтроку(СтрокаСообщений);
	
	Если МассивСообщений.Количество() > 1 И Элементы.ГруппаОшибкиДанных.Скрыта() Тогда
		Элементы.ГруппаОшибкиДанных.Показать();
	ИначеЕсли МассивСообщений.Количество() = 1 И НЕ Элементы.ГруппаОшибкиДанных.Скрыта() Тогда
		Элементы.ГруппаОшибкиДанных.Скрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОшибки_НеуникальностьСоздания(МассивСообщенийОбщий)
	
	МассивСообщений = Новый Массив; // Массив из Строка
	
	Выборка = ПолучитьНеуникальныеСоздания();
	Если Выборка.Количество() Тогда
		// Заголовок
		СообщениеСтрока = Новый ФорматированнаяСтрока("   Дубль действия ""Создан""   ",
			Новый Шрифт(, , Истина), ЦветаСтиля.ЦветФонаФормы, ЦветаСтиля.ЦветАкцента);
		МассивСообщений.Добавить(СообщениеСтрока);
		МассивСообщений.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
	КонецЕсли;
	Пока Выборка.Следующий() Цикл
		// Текст
		СообщениеСтрокаТекст = СтрШаблон(НСтр("ru = ' - %1'"), Выборка.ОбъектРеестраПредставление);
		СообщениеСтрока = Новый ФорматированнаяСтрока(СообщениеСтрокаТекст);
		МассивСообщений.Добавить(СообщениеСтрока);
		МассивСообщений.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
	КонецЦикла;
	Если МассивСообщений.Количество() Тогда
		// Рекомендации
		СообщениеСтрокаТекст = НСтр("ru = 'Рекомендации по исправлению:
			|1. Откройте список регистра сведений.
			|2. Установите в списке отбор по объекту с дублем и действию ""Создан"".
			|3. Удалите или измените дублирующуюся строку.'");
		СообщениеСтрока = Новый ФорматированнаяСтрока(СообщениеСтрокаТекст, , ЦветаСтиля.ЦветАкцента);
		МассивСообщений.Добавить(СообщениеСтрока);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСообщенийОбщий, МассивСообщений);
	
КонецПроцедуры

// Получить неуникальные создания.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Получить неуникальные создания:
//  * ОбъектРеестра - СправочникСсылка.ОбъектыФункций
//  * Действие - Число
//  * ОбъектРеестраПредставление - Строка
&НаСервере
Функция ПолучитьНеуникальныеСоздания()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеестрФункций.ОбъектРеестра КАК ОбъектРеестра,
		|	КОЛИЧЕСТВО(РеестрФункций.Действие) КАК Действие,
		|	РеестрФункций.ОбъектРеестра.Представление КАК ОбъектРеестраПредставление
		|ИЗ
		|	РегистрСведений.РеестрФункций КАК РеестрФункций
		|ГДЕ
		|	РеестрФункций.Действие = ЗНАЧЕНИЕ(Справочник.Действия.Создан)
		|
		|СГРУППИРОВАТЬ ПО
		|	РеестрФункций.ОбъектРеестра,
		|	РеестрФункций.ОбъектРеестра.Представление
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РеестрФункций.Действие) > 1";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;
	
КонецФункции

#КонецОбласти

#КонецОбласти
