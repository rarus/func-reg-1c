<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Запрос</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗадачаРеестра</dataPath>
			<field>ЗадачаРеестра</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Задача</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">25</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбъектРеестра</dataPath>
			<field>ОбъектРеестра</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Объект</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Действие</dataPath>
			<field>Действие</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФункцияРеестра</dataPath>
			<field>ФункцияРеестра</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Функция</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<presentationExpression>ФункцияРеестра.Наименование</presentationExpression>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">25</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Символ</dataPath>
			<field>Символ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатусЗадачи</dataPath>
			<field>СтатусЗадачи</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>АвторЗадачи</dataPath>
			<field>АвторЗадачи</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Проект</dataPath>
			<field>Проект</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Проект</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РеестрФункций.ОбъектРеестра КАК ОбъектРеестра,
	РеестрФункций.ЗадачаРеестра КАК ЗадачаРеестра,
	РеестрФункций.ФункцияРеестра КАК ФункцияРеестра,
	РеестрФункций.Действие.Символ КАК Символ,
	РеестрФункций.ЗадачаРеестра.СтатусЗадачи КАК СтатусЗадачи,
	РеестрФункций.ЗадачаРеестра.Автор КАК АвторЗадачи
{ВЫБРАТЬ
	ОбъектРеестра.*,
	ЗадачаРеестра.*,
	ФункцияРеестра.*,
	Символ,
	СтатусЗадачи.*,
	АвторЗадачи}
ИЗ
	РегистрСведений.РеестрФункций КАК РеестрФункций
{ГДЕ
	РеестрФункций.ОбъектРеестра.*,
	РеестрФункций.ЗадачаРеестра.*,
	РеестрФункций.ФункцияРеестра.*,
	РеестрФункций.Действие.*,
	РеестрФункций.ЗадачаРеестра.СтатусЗадачи.* КАК СтатусЗадачи,
	РеестрФункций.ЗадачаРеестра.Автор.* КАК АвторЗадачи,
	РеестрФункций.ЗадачаРеестра.Проект.* КАК Проект}</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>Инструкции</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Инструкция</dataPath>
			<field>Инструкция</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗадачаРеестра</dataPath>
			<field>ЗадачаРеестра</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Задача реестра</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФункцияРеестра</dataPath>
			<field>ФункцияРеестра</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Функция реестра</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Инструкции.Задача КАК ЗадачаРеестра,
	Инструкции.Функция КАК ФункцияРеестра,
	Инструкции.Инструкция.Код КАК Инструкция
{ВЫБРАТЬ
	ЗадачаРеестра.*,
	ФункцияРеестра.*,
	Инструкция}
ИЗ
	РегистрСведений.Инструкции КАК Инструкции
ГДЕ
	Инструкции.Описано
{ГДЕ
	Инструкции.Задача.* КАК ЗадачаРеестра,
	Инструкции.Функция.* КАК ФункцияРеестра}

УПОРЯДОЧИТЬ ПО
	Инструкция</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>Запрос</sourceDataSet>
		<destinationDataSet>Инструкции</destinationDataSet>
		<sourceExpression>ЗадачаРеестра</sourceExpression>
		<destinationExpression>ЗадачаРеестра</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>Запрос</sourceDataSet>
		<destinationDataSet>Инструкции</destinationDataSet>
		<sourceExpression>ФункцияРеестра</sourceExpression>
		<destinationExpression>ФункцияРеестра</destinationExpression>
	</dataSetLink>
	<calculatedField>
		<dataPath>ФункцияУровень2</dataPath>
		<expression>ВЫБОР
		КОГДА НЕ ФункцияРеестра.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
			ТОГДА ФункцияРеестра.Родитель
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
	КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Группа (2 уровень)</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">15</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>ФункцияУровень1</dataPath>
		<expression>ВЫБОР
		КОГДА ФункцияРеестра.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Функции.ПустаяСсылка)
			ТОГДА ФункцияРеестра.Родитель
		ИНАЧЕ ФункцияРеестра.Родитель.Родитель
	КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Группа (1 уровень)</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">15</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>Инструкции</dataPath>
		<expression>СоединитьСтроки(Инструкция, ", ")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Инструкции</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">15</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<totalField>
		<dataPath>Символ</dataPath>
		<expression>Символ</expression>
		<group>ОбъектРеестра</group>
	</totalField>
	<totalField>
		<dataPath>Символ</dataPath>
		<expression>Количество(Символ)</expression>
		<group>ОбъектРеестра Иерархия</group>
	</totalField>
	<totalField>
		<dataPath>ФункцияУровень1</dataPath>
		<expression>ФункцияУровень1</expression>
	</totalField>
	<totalField>
		<dataPath>ФункцияУровень2</dataPath>
		<expression>ФункцияУровень2</expression>
	</totalField>
	<totalField>
		<dataPath>Инструкции</dataPath>
		<expression>Инструкции</expression>
	</totalField>
	<template>
		<name>Макет1</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
