<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Запрос</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбъектРеестра</dataPath>
			<field>ОбъектРеестра</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Действие</dataPath>
			<field>Действие</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФункцияРеестра</dataPath>
			<field>ФункцияРеестра</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>АвторФункции</dataPath>
			<field>АвторФункции</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Автор функции</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Задача</dataPath>
			<field>Задача</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Задача</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>АвторЗадачи</dataPath>
			<field>АвторЗадачи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Автор задачи</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаФункции</dataPath>
			<field>ДатаФункции</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата функции</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаСозданияЗадачи</dataPath>
			<field>ДатаСозданияЗадачи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата создания задачи</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Проект</dataPath>
			<field>Проект</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Раздел</dataPath>
			<field>Раздел</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Раздел</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	"Новые функции" КАК Раздел,
	РеестрФункций.ДатаСоздания КАК ДатаФункции,
	РеестрФункций.Автор КАК АвторФункции,
	РеестрФункций.ФункцияРеестра КАК ФункцияРеестра,
	РеестрФункций.ОбъектРеестра КАК ОбъектРеестра,
	РеестрФункций.ЗадачаРеестра КАК ЗадачаРеестра,
	РеестрФункций.Действие КАК Действие
ПОМЕСТИТЬ втРегистр
ИЗ
	РегистрСведений.РеестрФункций КАК РеестрФункций
ГДЕ
	РеестрФункций.ДатаСоздания = РеестрФункций.ДатаИзменения
	И РеестрФункций.ДатаСоздания МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Новые функции",
	РеестрФункций.ДатаСоздания,
	РеестрФункций.Автор,
	РеестрФункций.ФункцияРеестра,
	РеестрФункций.ОбъектРеестра,
	РеестрФункций.ЗадачаРеестра,
	РеестрФункций.Действие
ИЗ
	РегистрСведений.РеестрФункций КАК РеестрФункций
ГДЕ
	РеестрФункций.ДатаИзменения = ДАТАВРЕМЯ(1, 1, 1)
	И РеестрФункций.ДатаСоздания МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Измененные функции",
	РеестрФункций.ДатаИзменения,
	РеестрФункций.АвторИзменения,
	РеестрФункций.ФункцияРеестра,
	РеестрФункций.ОбъектРеестра,
	РеестрФункций.ЗадачаРеестра,
	РеестрФункций.Действие
ИЗ
	РегистрСведений.РеестрФункций КАК РеестрФункций
ГДЕ
	НЕ РеестрФункций.ДатаСоздания = РеестрФункций.ДатаИзменения
	И РеестрФункций.ДатаИзменения МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

ИНДЕКСИРОВАТЬ ПО
	ЗадачаРеестра
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗадачиУчетныхСистем.Ссылка КАК Задача,
	ЗадачиУчетныхСистем.Проект КАК Проект,
	ЗадачиУчетныхСистем.Автор КАК АвторЗадачи,
	ЗадачиУчетныхСистем.ДатаСоздания КАК ДатаСозданияЗадачи
ПОМЕСТИТЬ втСправочник
ИЗ
	Справочник.ЗадачиУчетныхСистем КАК ЗадачиУчетныхСистем
ГДЕ
	ЗадачиУчетныхСистем.ДатаСоздания МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	втСправочник.Задача КАК Задача,
	втСправочник.Проект КАК Проект,
	втСправочник.АвторЗадачи КАК АвторЗадачи,
	втСправочник.ДатаСозданияЗадачи КАК ДатаСозданияЗадачи,
	втРегистр.Раздел КАК Раздел,
	втРегистр.ДатаФункции КАК ДатаФункции,
	втРегистр.АвторФункции КАК АвторФункции,
	втРегистр.ФункцияРеестра КАК ФункцияРеестра,
	втРегистр.ОбъектРеестра КАК ОбъектРеестра,
	втРегистр.Действие КАК Действие
ИЗ
	втСправочник КАК втСправочник
		ПОЛНОЕ СОЕДИНЕНИЕ втРегистр КАК втРегистр
		ПО втСправочник.Задача = втРегистр.ЗадачаРеестра</query>
	</dataSet>
	<calculatedField>
		<dataPath>КоличествоЗадач</dataPath>
		<expression>Задача</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Количество задач</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>КоличествоФункций</dataPath>
		<expression>ФункцияРеестра</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Количество функций</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>КоличествоЗадач</dataPath>
		<expression>Количество(Различные КоличествоЗадач)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоФункций</dataPath>
		<expression>Количество(КоличествоФункций)</expression>
	</totalField>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">ThisMonth</v8:variant>
		</value>
		<useRestriction>false</useRestriction>
		<denyIncompleteValues>true</denyIncompleteValues>
	</parameter>
	<settingsVariant>
		<dcsset:name>ДетализацияДинамикиСозданияЗадач</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
